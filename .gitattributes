# Check out text with LF on every platform. The pinned workflow runtime digest
# hashes raw package source bytes, so CRLF checkouts would pin a different runtime.
* text=auto eol=lf

*.blend binary
*.png binary
*.jpg binary
*.jpeg binary
*.exr binary
*.hdr binary
*.whl binary
*.zip binary

# Preserve upstream bytes so the checked-in compatibility digest survives Windows checkout.
dcc_harness/data/bridge/upstream.py -text
dcc_harness/data/bridge/LICENSE.upstream -text
