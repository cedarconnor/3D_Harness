{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "enum": [
        "dcc.capability.recipe.v1",
        "dcc.capability.recipe.v2"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9_.-]{0,126}[a-zA-Z0-9_-])?$(?![\\s\\S])",
      "not": {
        "pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|$)"
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9_.-]{0,126}[a-zA-Z0-9_-])?$(?![\\s\\S])",
        "not": {
          "pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|$)"
        }
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "provider": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9_.-]{0,126}[a-zA-Z0-9_-])?$(?![\\s\\S])",
          "not": {
            "pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|$)"
          }
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "source_digest"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "description": "Validated by recipe_schema.parameter_schema; closed portable subset only."
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "blender_min": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "blender_max": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 3,
          "maxItems": 3
        },
        "engines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "target_types": {
          "type": "array",
          "items": {
            "enum": [
              "MESH",
              "EMPTY",
              "CAMERA",
              "LIGHT"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "contexts": {
          "type": "array",
          "items": {
            "enum": [
              "background",
              "live"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "blender_min",
        "blender_max",
        "engines",
        "target_types",
        "contexts"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "reads": {
          "type": "array",
          "items": {
            "enum": [
              "geometry",
              "transform",
              "materials",
              "modifiers",
              "nodes",
              "properties"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "writes": {
          "type": "array",
          "items": {
            "enum": [
              "geometry",
              "transform",
              "materials",
              "modifiers",
              "nodes",
              "properties"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "enum": [
              "geometry",
              "transform",
              "materials",
              "modifiers",
              "nodes",
              "properties"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "reads",
        "writes",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "invocation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "python_function",
                "operator",
                "node_asset"
              ]
            },
            "entry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "completion": {
              "const": "synchronous"
            },
            "cancellation": {
              "const": "between_calls"
            },
            "arguments": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^(target|effect_name|effect_id|parameters|context|parameter:[A-Za-z0-9_.-]+)$"
              }
            }
          },
          "required": [
            "kind",
            "entry",
            "completion",
            "cancellation"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "node_asset"
                  }
                }
              },
              "then": {
                "properties": {
                  "entry": {
                    "pattern": "^[^\\u0000-\\u001f\\u007f]{1,255}$(?![\\s\\S])",
                    "maxLength": 255
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "python_function"
                  }
                }
              },
              "then": {
                "properties": {
                  "entry": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$(?![\\s\\S])"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "operator"
                  }
                }
              },
              "then": {
                "properties": {
                  "entry": {
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$(?![\\s\\S])",
                    "maxLength": 128
                  }
                }
              }
            },
            {
              "if": {
                "required": [
                  "arguments"
                ]
              },
              "then": {
                "properties": {
                  "kind": {
                    "const": "python_function"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "python_function"
            },
            "entry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$(?![\\s\\S])"
            },
            "completion": {
              "const": "asynchronous"
            },
            "cancellation": {
              "const": "cooperative"
            },
            "poll": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$(?![\\s\\S])"
            },
            "cancel": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$(?![\\s\\S])"
            },
            "collect": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$(?![\\s\\S])"
            },
            "poll_interval": {
              "type": "number",
              "minimum": 0.05,
              "maximum": 5
            },
            "timeout": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 3600
            },
            "cancel_grace": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 60
            },
            "arguments": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^(target|effect_name|effect_id|parameters|context|parameter:[A-Za-z0-9_.-]+)$"
              }
            }
          },
          "required": [
            "kind",
            "entry",
            "completion",
            "cancellation",
            "poll",
            "cancel",
            "collect",
            "poll_interval",
            "timeout",
            "cancel_grace"
          ],
          "additionalProperties": false
        }
      ]
    },
    "update": {
      "type": "object",
      "properties": {
        "identity": {
          "const": "effect_key"
        },
        "shared_materials": {
          "enum": [
            "none",
            "all_users",
            "single_user_copy"
          ]
        }
      },
      "required": [
        "identity",
        "shared_materials"
      ],
      "additionalProperties": false
    },
    "validators": {
      "const": [
        "inspect_output",
        "verify_saved"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9_.-]{0,126}[a-zA-Z0-9_-])?$(?![\\s\\S])",
            "not": {
              "pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|$)"
            }
          },
          "parameters": {
            "type": "object"
          },
          "context": {
            "enum": [
              "background",
              "live"
            ]
          },
          "expect": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "failure_contains": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "name",
          "parameters",
          "context",
          "expect"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "expect": {
                  "const": "fail"
                }
              }
            },
            "then": {
              "required": [
                "failure_contains"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "failure_contains"
                ]
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "modifier"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "material"
            },
            "material_id": {
              "const": "{effect_name}"
            },
            "slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1023
            }
          },
          "required": [
            "kind",
            "material_id",
            "slot"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "shader_nodes"
            },
            "material_id": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9_.-]{0,126}[a-zA-Z0-9_-])?$(?![\\s\\S])",
                  "not": {
                    "pattern": "^(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][0-9]|[Ll][Pp][Tt][0-9])(?:\\.|$)"
                  }
                },
                {
                  "const": "{effect_name}"
                }
              ]
            },
            "slot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1023
            },
            "nodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^\\{effect_name\\}[ -z|~]{0,10}$(?![\\s\\S])"
              },
              "description": "Owned deterministic node selectors: effect_name expands to DCC:: plus the first 48 effect ID characters; optional printable ASCII suffix is at most 10 bytes, excluding braces."
            }
          },
          "required": [
            "kind",
            "material_id",
            "slot",
            "nodes"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "version",
    "capabilities",
    "provider",
    "parameters",
    "compatibility",
    "coverage",
    "invocation",
    "update",
    "validators",
    "cases"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "const": "dcc.capability.recipe.v1"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "effect"
          ]
        },
        "properties": {
          "invocation": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "python_function",
                  "operator",
                  "node_asset"
                ]
              },
              "entry": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "completion": {
                "const": "synchronous"
              },
              "cancellation": {
                "const": "between_calls"
              },
              "arguments": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^(target|effect_name|effect_id|parameters|context|parameter:[A-Za-z0-9_.-]+)$"
                }
              }
            },
            "required": [
              "kind",
              "entry",
              "completion",
              "cancellation"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "node_asset"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "entry": {
                      "pattern": "^[^\\u0000-\\u001f\\u007f]{1,255}$(?![\\s\\S])",
                      "maxLength": 255
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "python_function"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "entry": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+$(?![\\s\\S])"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "operator"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "entry": {
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]*\\.[A-Za-z_][A-Za-z0-9_]*$(?![\\s\\S])",
                      "maxLength": 128
                    }
                  }
                }
              },
              {
                "if": {
                  "required": [
                    "arguments"
                  ]
                },
                "then": {
                  "properties": {
                    "kind": {
                      "const": "python_function"
                    }
                  }
                }
              }
            ]
          },
          "coverage": {
            "properties": {
              "writes": {
                "contains": {
                  "const": "modifiers"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": "dcc.capability.recipe.v2"
          }
        }
      },
      "then": {
        "required": [
          "effect"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "effect": {
                  "properties": {
                    "kind": {
                      "const": "modifier"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "coverage": {
                  "properties": {
                    "writes": {
                      "contains": {
                        "const": "modifiers"
                      }
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "coverage": {
                  "properties": {
                    "writes": {
                      "contains": {
                        "enum": [
                          "materials",
                          "nodes"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "coverage": {
                  "properties": {
                    "writes": {
                      "contains": {
                        "enum": [
                          "materials",
                          "nodes"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "update": {
                  "properties": {
                    "shared_materials": {
                      "enum": [
                        "all_users",
                        "single_user_copy"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
